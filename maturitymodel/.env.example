# Credenciais do front (Vite). Copie para `.env` e preencha.
# São chaves PÚBLICAS do Supabase (protegidas por RLS) — NÃO coloque aqui o service_role.
# Onde obter: Supabase Dashboard → Project Settings → API.

VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-anon-publishable-key"

# URL do hub NEO — para onde o Portal redireciona quando não há sessão (login é lá).
VITE_HUB_URL="https://neo-hub.vercel.app"
